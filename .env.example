# ==============================================================================
# MEHFUS MUNICIPAL CITIZEN & AUTHORITY SAFETY PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env.local' and add your secret API keys:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# Google Maps Platform API Key
# ------------------------------------------------------------------------------
# Used for Google Maps JavaScript SDK, Places Autocomplete, and Geocoding
# Get your API key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Integration (Optional Free Tier)
# ------------------------------------------------------------------------------
# If left empty, Mehfus runs seamlessly in resilient local offline-mesh mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
